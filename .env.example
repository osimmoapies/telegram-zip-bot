# Copy to .env for local runs:  cp .env.example .env
# Required — your bot token from @BotFather
BOT_TOKEN=123456:ABC-your-token-here

# Optional — force webhook mode (leave empty for polling / local use)
# WEBHOOK_URL=https://your-app.example.com

# Optional — port for the health/webhook server (set automatically by most hosts)
# PORT=8000
